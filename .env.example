# Local-only Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Durable application storage (relative to this project unless absolute)
DATA_PATH=./data

# Retrieval defaults; evaluate against your own documents before tuning
TOP_K=3
RETRIEVAL_CANDIDATE_MULTIPLIER=10
HYBRID_LEXICAL_WEIGHT=0.20
LEXICAL_CANDIDATE_LIMIT=20
MIN_SIMILARITY=0.25
MAX_CONTEXT_CHARS=3000
MAX_QUESTION_PARTS=2

# Local processing
# TIMEOUT is a per-Ollama-call limit, not a whole-request budget. A single
# grounded answer can exceed 90 s on CPU-only hosts, so allow generous headroom.
EMBEDDING_BATCH_SIZE=16
TEMPERATURE=0.0
TIMEOUT=300
VERIFY_ANSWERS=true
# Decode caps in tokens. Answer generation dominates CPU time; the verifier
# only needs to emit a single label word.
ANSWER_MAX_TOKENS=220
VERIFY_MAX_TOKENS=8
RECOVERY_ON_STARTUP=true
OCR_ENABLED=true
# Optional: absolute path to tesseract.exe on Windows
TESSERACT_CMD=

# Local RAG cache (separate from permanent documents/indexes)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800
CACHE_MAX_ENTRIES=2000
SEMANTIC_RETRIEVAL_THRESHOLD=0.94
SEMANTIC_ANSWER_CACHE_ENABLED=false
SEMANTIC_ANSWER_THRESHOLD=0.975
